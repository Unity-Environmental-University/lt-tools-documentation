{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the Assignment Override Student."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Stores measures related to ad hoc users for whom an assignment override exists."
            },
            "value": {
                "type": "object",
                "properties": {
                    "user_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Identifies the user."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when the `assignment_override_student` record was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when the `assignment_override_student` was last updated."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "active",
                            "deleted"
                        ],
                        "description": "Life-cycle state for assignment override students record."
                    },
                    "assignment_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Identifies the assignment the override is associated with."
                    },
                    "quiz_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Identifies the quiz the override is associated with."
                    },
                    "assignment_override_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Identifies the assignment override dimension."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "user_id",
                    "created_at",
                    "updated_at",
                    "workflow_state",
                    "assignment_override_id"
                ],
                "title": "Stores measures related to ad hoc users for whom an assignment override exists."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}