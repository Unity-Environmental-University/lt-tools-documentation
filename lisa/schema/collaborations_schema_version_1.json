{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the collaboration."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "This table contains attributes related to collaborations."
            },
            "value": {
                "type": "object",
                "properties": {
                    "collaboration_type": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The type of the collaboration."
                    },
                    "document_id": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The ID of the document."
                    },
                    "user_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the user."
                    },
                    "context_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the context."
                    },
                    "context_type": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "Account",
                            "Group",
                            "Course"
                        ],
                        "description": "The type of the context."
                    },
                    "url": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The URL of the collaboration."
                    },
                    "uuid": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The UUID of the collaboration."
                    },
                    "data": {
                        "type": "string",
                        "description": "The data of the collaboration."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "The date this collaboration was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "The date this collaboration was updated."
                    },
                    "description": {
                        "oneOf": [
                            {
                                "type": "string",
                                "const": "__dap_oversized_truncated__"
                            },
                            {
                                "type": "string"
                            }
                        ],
                        "description": "The description of the collaboration."
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The title of the collaboration."
                    },
                    "workflow_state": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The workflow state of the collaboration."
                    },
                    "deleted_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "The date this collaboration was deleted."
                    },
                    "context_code": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The context code of the collaboration."
                    },
                    "type": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The type of the collaboration."
                    },
                    "resource_link_lookup_uuid": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The UUID of the resource"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "created_at",
                    "updated_at",
                    "title",
                    "workflow_state"
                ],
                "title": "This table contains attributes related to collaborations."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}