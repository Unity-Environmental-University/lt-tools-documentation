{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for the custom grade status."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Stores custom grade status definitions for accounts.",
                "description": "Custom grade statuses allow accounts to define custom labels and colors for submission statuses."
            },
            "value": {
                "type": "object",
                "properties": {
                    "color": {
                        "type": "string",
                        "maxLength": 7,
                        "description": "The hex color code for the status (e.g., #FF0000)."
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 14,
                        "description": "The display name for the status."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "active",
                            "deleted"
                        ],
                        "description": "The current state of the custom grade status."
                    },
                    "created_by_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the user who created this status."
                    },
                    "deleted_by_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the user who deleted this status."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp when the status was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp when the status was last updated."
                    },
                    "applies_to_submissions": {
                        "type": "boolean",
                        "description": "Whether this status can be applied to submissions."
                    },
                    "applies_to_final_grade": {
                        "type": "boolean",
                        "description": "Whether this status affects final grades."
                    },
                    "allow_final_grade_value": {
                        "type": "boolean",
                        "description": "Whether to allow a final grade value when this status is applied."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "color",
                    "name",
                    "workflow_state",
                    "created_by_id",
                    "created_at",
                    "updated_at",
                    "applies_to_submissions",
                    "applies_to_final_grade",
                    "allow_final_grade_value"
                ],
                "title": "Stores custom grade status definitions for accounts.",
                "description": "Custom grade statuses allow accounts to define custom labels and colors for submission statuses."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}