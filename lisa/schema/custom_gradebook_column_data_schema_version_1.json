{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for a custom gradebook column data record."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Contains per-user data for the custom columns defined in custom_gradebook_columns."
            },
            "value": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "The particular value of the specified column for the user denoted by user_id."
                    },
                    "user_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique ID of the user to whom this data record applies."
                    },
                    "custom_gradebook_column_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the associated custom column."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "content",
                    "user_id",
                    "custom_gradebook_column_id"
                ],
                "title": "Contains per-user data for the custom columns defined in custom_gradebook_columns."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}