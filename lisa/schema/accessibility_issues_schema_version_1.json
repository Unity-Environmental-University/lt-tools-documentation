{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for the accessibility issue."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Stores data about accessibility issues detected in course content.",
                "description": "Each issue represents a specific accessibility problem found in a wiki page, assignment, or attachment."
            },
            "value": {
                "type": "object",
                "properties": {
                    "course_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the course containing the content with the issue."
                    },
                    "wiki_page_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the wiki page with the accessibility issue."
                    },
                    "assignment_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the assignment with the accessibility issue."
                    },
                    "attachment_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the attachment with the accessibility issue."
                    },
                    "rule_type": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "adjacent-links",
                            "headings-sequence",
                            "headings-start-at-h2",
                            "img-alt",
                            "img-alt-filename",
                            "img-alt-length",
                            "large-text-contrast",
                            "list-structure",
                            "paragraphs-for-headings",
                            "small-text-contrast",
                            "table-caption",
                            "table-header",
                            "table-header-scope"
                        ],
                        "description": "The type of accessibility rule that was violated."
                    },
                    "node_path": {
                        "type": "string",
                        "maxLength": 1024,
                        "description": "The path to the DOM node where the issue was found."
                    },
                    "metadata": {
                        "type": "string",
                        "description": "Additional metadata about the accessibility issue."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "active",
                            "closed",
                            "dismissed",
                            "resolved"
                        ],
                        "description": "The current state of the accessibility issue."
                    },
                    "updated_by_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the user who last updated the issue."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp when the accessibility issue was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp when the accessibility issue was last updated."
                    },
                    "accessibility_resource_scan_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the resource scan that detected this issue."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "course_id",
                    "rule_type",
                    "metadata",
                    "workflow_state",
                    "created_at",
                    "updated_at",
                    "accessibility_resource_scan_id"
                ],
                "title": "Stores data about accessibility issues detected in course content.",
                "description": "Each issue represents a specific accessibility problem found in a wiki page, assignment, or attachment."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}