{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier of a content participation record."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Stores data related to students submission updates or feedback.",
                "description": "Examples include new grade, new excused status, or new score."
            },
            "value": {
                "type": "object",
                "properties": {
                    "user_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique ID of a user."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "read",
                            "unread"
                        ],
                        "description": "Current state of the record."
                    },
                    "content_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier of a content record."
                    },
                    "content_type": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "Submission"
                        ],
                        "description": "The type of the object represented by `content_id`."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "user_id",
                    "workflow_state",
                    "content_id",
                    "content_type"
                ],
                "title": "Stores data related to students submission updates or feedback.",
                "description": "Examples include new grade, new excused status, or new score."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}