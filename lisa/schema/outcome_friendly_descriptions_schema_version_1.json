{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for an outcome friendly description record."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Outcome friendly descriptions provide user-friendly descriptions for learning outcomes within a context."
            },
            "value": {
                "type": "object",
                "properties": {
                    "context_type": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "Account",
                            "Course"
                        ],
                        "description": "The type of the object represented by context_id."
                    },
                    "context_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for the context of the outcome friendly description."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "active",
                            "deleted"
                        ],
                        "description": "Workflow status of the outcome friendly description."
                    },
                    "description": {
                        "oneOf": [
                            {
                                "type": "string",
                                "const": "__dap_oversized_truncated__"
                            },
                            {
                                "type": "string"
                            }
                        ],
                        "description": "The friendly description text for the learning outcome."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when an `outcome_friendly_descriptions` record was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when an `outcome_friendly_descriptions` record was updated."
                    },
                    "learning_outcome_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The ID of the learning outcome this description is associated with."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "context_type",
                    "context_id",
                    "workflow_state",
                    "description",
                    "created_at",
                    "updated_at",
                    "learning_outcome_id"
                ],
                "title": "Outcome friendly descriptions provide user-friendly descriptions for learning outcomes within a context."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}