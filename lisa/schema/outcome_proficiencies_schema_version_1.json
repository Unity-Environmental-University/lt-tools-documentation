{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for an outcome proficiency record."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Outcome proficiencies, or learning mastery proficiency ratings, define a set of ratings, which together create a point scale and a mastery level."
            },
            "value": {
                "type": "object",
                "properties": {
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when an `outcome_proficiencies` record was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when an `outcome_proficiencies` record was updated."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "active",
                            "deleted"
                        ],
                        "description": "Workflow status of the outcome_proficiency. Defaults to `active`."
                    },
                    "context_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for the context (account or course) of the outcome proficiency."
                    },
                    "context_type": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "Account",
                            "Course"
                        ],
                        "description": "The type of the object represented by context_id."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "created_at",
                    "updated_at",
                    "workflow_state",
                    "context_id",
                    "context_type"
                ],
                "title": "Outcome proficiencies, or learning mastery proficiency ratings, define a set of ratings, which together create a point scale and a mastery level."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}