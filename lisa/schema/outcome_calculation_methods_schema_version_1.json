{
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
            "meta": {
                "type": "object",
                "properties": {
                    "ts": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "U",
                            "D"
                        ],
                        "title": "Identifies if a record is to be upserted (inserted or updated) or (hard) deleted."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "ts"
                ],
                "title": "Meta-information associated with the record."
            },
            "key": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for an outcome calculation method record."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "id"
                ],
                "title": "Outcome calculation methods define how outcome scores are calculated for a context (account or course)."
            },
            "value": {
                "type": "object",
                "properties": {
                    "context_type": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "Account",
                            "Course"
                        ],
                        "description": "The type of the object represented by context_id."
                    },
                    "context_id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The unique identifier for the context of the outcome calculation method."
                    },
                    "calculation_int": {
                        "type": "integer",
                        "format": "int16",
                        "description": "An integer parameter used in certain calculation methods."
                    },
                    "calculation_method": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "decaying_average",
                            "average",
                            "highest",
                            "latest",
                            "n_mastery",
                            "weighted_average",
                            "standard_decaying_average"
                        ],
                        "description": "The method used to calculate the outcome score."
                    },
                    "workflow_state": {
                        "type": "string",
                        "enum": [
                            "__dap_unspecified__",
                            "active",
                            "deleted"
                        ],
                        "description": "Workflow status of the outcome calculation method."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when an `outcome_calculation_methods` record was created."
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Timestamp of when an `outcome_calculation_methods` record was updated."
                    }
                },
                "additionalProperties": false,
                "required": [
                    "context_type",
                    "context_id",
                    "calculation_method",
                    "workflow_state",
                    "created_at",
                    "updated_at"
                ],
                "title": "Outcome calculation methods define how outcome scores are calculated for a context (account or course)."
            }
        },
        "additionalProperties": false,
        "required": [
            "key"
        ]
    },
    "version": 1
}